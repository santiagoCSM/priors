---
import BaseLayout from "../layouts/BaseLayout.astro";
import GaussianCoaster from "../components/GaussianCoaster.astro";
import { projects } from "../data/projects";
import { fetchAllBoards } from "../lib/fetchBoard";

const boards = await fetchAllBoards(projects);
---

<BaseLayout
  title="Priors"
  description="Investigación cuantitativa abierta y pre-registrada — metodología documentada antes de ver resultados, hallazgos positivos y negativos publicados por igual."
>
  <header class="masthead">
    <div class="masthead-inner">
      <div class="masthead-copy">
        <div class="doc-eyebrow"><span class="hero-dot" aria-hidden="true"></span><span>Investigación cuantitativa</span><span aria-hidden="true">/</span><span>Abierta y pre-registrada</span></div>
        <h1 class="doc-title">Priors<span class="hero-period">.</span></h1>
        <p class="hero-statement">Primero la hipótesis.<br /><em>Después la evidencia.</em></p>
        <p class="doc-subtitle">
          Un espacio para poner a prueba ideas con reglas claras: cada proyecto define
          su hipótesis, su referencia de comparación y sus criterios de éxito antes
          de analizar los resultados. Los hallazgos se publican, confirmen o no lo esperado.
        </p>
        <div class="hero-actions">
          <a class="hero-primary" href="#proyectos">Explorar investigaciones <span aria-hidden="true">↗</span></a>
          <a class="hero-secondary" href="#estado">Consultar evidencia <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-footnote">Hipótesis claras <span aria-hidden="true">·</span> Métodos verificables <span aria-hidden="true">·</span> Resultados abiertos</p>
      </div>
      <div class="masthead-art">
        <div class="hero-art-label"><span>FIG. 01</span><span>UNA DISTRIBUCIÓN, MUCHOS RESULTADOS</span></div>
        <GaussianCoaster />
      </div>
    </div>
  </header>

  <main>
    <section id="proyectos">
      <div class="eyebrow">Proyectos</div>
      <h2>Investigaciones en curso</h2>
      <div class="card-grid">
        {
          projects.map((p) => (
            <a class="card" href={p.siteUrl}>
              <span class="card-tag">Investigación activa</span>
              <h3>{p.name}</h3>
              <p>{p.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section id="estado">
      <div class="eyebrow">Estado agregado</div>
      <h2>En qué nivel de evidencia está cada hipótesis</h2>
      <p>
        Jalado en cada build directamente del <code>board.md</code> de cada
        proyecto — nunca se transcribe a mano, así que nunca se desactualiza
        respecto al repositorio original.
      </p>

      {
        boards.map((b) =>
          b.error ? (
            <p>
              <em>
                No se pudo leer el tablero de {b.project.name}: {b.error}
              </em>
            </p>
          ) : (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Proyecto</th>
                    <th>Hipótesis</th>
                    <th>Estado</th>
                    <th>Nivel</th>
                    <th>Evidencia clave</th>
                  </tr>
                </thead>
                <tbody>
                  {b.rows.map((row) => (
                    <tr>
                      <td>{b.project.name}</td>
                      <td>{row.hipotesis}</td>
                      <td>
                        <span class={`pill pill--${row.kind}`}>{row.shortLabel}</span>
                        {row.estado !== row.shortLabel && (
                          <p class="estado-detail">{row.estado}</p>
                        )}
                      </td>
                      <td>{row.nivel}</td>
                      <td>{row.evidencia}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        )
      }
    </section>
  </main>

  <footer>
    Priors — <a href="https://github.com/nobodywhois0/priors">código fuente</a>.
    Cada proyecto vive en su propio repositorio; este sitio solo los indexa
    y agrega su estado.
  </footer>
</BaseLayout>

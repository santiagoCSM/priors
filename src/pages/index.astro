---
import BaseLayout from "../layouts/BaseLayout.astro";
import GaussianCoaster from "../components/GaussianCoaster.astro";
import { projects } from "../data/projects";
import { fetchAllBoards } from "../lib/fetchBoard";

const boards = await fetchAllBoards(projects);
const failedBoards = boards.filter((board) => board.error);
if (import.meta.env.PROD && failedBoards.length > 0) {
  throw new Error(
    "Se canceló el despliegue para conservar la versión anterior: " +
    failedBoards.map((board) => board.project.name + " (" + board.error + ")").join("; ")
  );
}
const validBoards = boards.filter((board) => !board.error);
const evidenceRows = validBoards.flatMap((board) => board.rows);
const pendingCount = evidenceRows.filter((row) => row.kind === "pending").length;
const reportedConfirmedCount = evidenceRows.filter((row) => row.kind === "confirmed" || row.kind === "confirmed-local").length;
const consultedAt = new Date();
const consultedAtLabel = new Intl.DateTimeFormat("es-MX", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(consultedAt);
---

<BaseLayout
  title="Priors · Investigación cuantitativa abierta"
  description="Investigación cuantitativa abierta y pre-registrada — metodología documentada antes de ver resultados, hallazgos positivos y negativos publicados por igual."
>
  <div class="docs-layout">
    <nav class="page-index" aria-label="Secciones de Priors">
      <p class="nav-label">Explorar Priors</p>
      <a href="#inicio">Inicio</a>
      <a href="#metodologia">Método</a>
      <a href="#proyectos">Investigaciones</a>
      <a href="#estado">Evidencia</a>
    </nav>

    <main id="contenido">
      <header class="masthead" id="inicio">
        <p class="eyebrow">Investigación cuantitativa abierta</p>
        <h1>Primero la hipótesis.<br /><em>Después la evidencia.</em></h1>
        <p class="doc-subtitle">
          Cada proyecto de Priors define su hipótesis, su referencia de comparación
          y sus criterios de éxito antes de analizar los datos. Publicamos los
          hallazgos tanto si confirman la hipótesis como si no.
        </p>
        <div class="hero-actions">
          <a class="hero-primary" href="#proyectos">Explorar investigaciones <span aria-hidden="true">↓</span></a>
          <a href="#estado">Consultar evidencia <span aria-hidden="true">↓</span></a>
        </div>
        <GaussianCoaster />
      </header>

      <section id="metodologia" class="methodology" aria-labelledby="methodology-title">
        <h2 id="methodology-title">Las reglas, antes que los resultados.</h2>
        <p class="method-intro">
          Cada investigación sigue un proceso abierto: formular una pregunta,
          contrastarla con datos y mostrar lo encontrado, incluso cuando no confirma lo esperado.
        </p>
        <ol class="method-grid">
          <li class="method-step">
            <span class="method-index">Pre-registro</span>
            <h3>Definir la hipótesis.</h3>
            <p>Antes de analizar los datos, se documentan la pregunta, la referencia de comparación y los criterios de éxito.</p>
          </li>
          <li class="method-step">
            <span class="method-index">Evaluación</span>
            <h3>Contrastar la evidencia.</h3>
            <p>Se prueba la hipótesis mediante un procedimiento explícito y se registran las métricas, comparaciones y limitaciones.</p>
          </li>
          <li class="method-step">
            <span class="method-index">Publicación</span>
            <h3>Publicar los resultados.</h3>
            <p>Se comparten los hallazgos, el nivel de evidencia y los siguientes pasos, tanto si la hipótesis se sostiene como si no.</p>
          </li>
        </ol>
      </section>

      <section id="proyectos" class="research-section" aria-labelledby="research-title">
        <div class="research-heading">
          <h2 id="research-title">Artículos de investigación</h2>
          <p>Un registro abierto de hipótesis, métodos y resultados. Cada artículo tiene su propia investigación y repositorio de origen.</p>
        </div>
        <div class="research-list">
          {
            boards.map((board) => (
              <article class="research-entry" aria-labelledby={`research-title-${board.project.slug}`}>
                <h3 id={`research-title-${board.project.slug}`}>{board.project.displayTitle || board.project.name.replace(/_/g, " ")}</h3>
                <p class="research-abstract">{board.project.description}</p>
                {board.error && <p class="research-unavailable">Registro no disponible</p>}
                <div class="research-links">
                  <a href={board.project.siteUrl} target="_blank" rel="noopener noreferrer">Leer investigación <span aria-hidden="true">↗</span></a>
                  <a class="research-source" href={`https://github.com/${board.project.repo}`} target="_blank" rel="noopener noreferrer">Código fuente <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="estado" class="evidence-section" aria-labelledby="evidence-title">
        <div class="evidence-heading">
          <h2 id="evidence-title">Registro de hipótesis y resultados</h2>
          <p>
            Un índice de la evidencia documentada por cada investigación.
            Los estados provienen del archivo <code>board.md</code> de cada repositorio
            al construir esta página.
          </p>
        </div>
        {validBoards.length > 0 && (
          <p class="evidence-updated">
            Fuentes consultadas: <time datetime={consultedAt.toISOString()}>{consultedAtLabel} UTC</time>
          </p>
        )}

        {validBoards.length > 0 && (
          <div class="evidence-summary" aria-label="Resumen del estado de las investigaciones">
            <div class="evidence-stat">
              <span class="evidence-stat-value">{String(evidenceRows.length).padStart(2, "0")}</span>
              <span class="evidence-stat-label">Hipótesis registradas</span>
            </div>
            <div class="evidence-stat">
              <span class="evidence-stat-value">{String(reportedConfirmedCount).padStart(2, "0")}</span>
              <span class="evidence-stat-label">Confirmaciones reportadas*</span>
            </div>
            <div class="evidence-stat">
              <span class="evidence-stat-value">{String(pendingCount).padStart(2, "0")}</span>
              <span class="evidence-stat-label">Hipótesis pendientes</span>
            </div>
          </div>
        )}

        {boards.map((b) => (
          <div class="evidence-project">
            <div class="evidence-project-head">
              <h3>{b.project.displayTitle || b.project.name.replace(/_/g, " ")}</h3>
              <a
                href={`https://github.com/${b.project.repo}/blob/${b.project.branch}/${b.project.boardPath}`}
                target="_blank"
                rel="noopener noreferrer"
              >Fuente original ↗</a>
            </div>
            {b.error ? (
              <p class="evidence-error" role="status">
                No se pudo consultar este registro durante la compilación ({b.error}).
                Los resultados siguen disponibles en su repositorio de origen.
              </p>
            ) : (
              <ul class="evidence-records">
                {b.rows.map((row) => (
                  <li class="evidence-record">
                    <span class={`pill pill--${row.kind}`}>{row.shortLabel}</span>
                    <h4>{row.hipotesis}</h4>
                    <details class="evidence-expand">
                      <summary>Ver detalles</summary>
                      <div class="evidence-record-details">
                        {row.estado !== row.shortLabel && <p class="evidence-qualification">{row.estado}</p>}
                        {row.nivel && <p class="evidence-level">Nivel de evidencia: <strong>{row.nivel}</strong></p>}
                        <div>
                          <span class="evidence-detail-label">Evidencia clave</span>
                          <p>{row.evidencia || "Sin evidencia publicada todavía."}</p>
                        </div>
                        {row.proximoPaso && (
                          <div>
                            <span class="evidence-detail-label">Próximo paso</span>
                            <p>{row.proximoPaso}</p>
                          </div>
                        )}
                      </div>
                    </details>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
        <p class="evidence-disclaimer">* Las clasificaciones se muestran tal como las reporta cada investigación y no equivalen necesariamente a validación externa o definitiva. Si una hipótesis tiene confirmación local, sus reservas y limitaciones se detallan en el registro correspondiente.</p>
      </section>
    </main>
  </div>

  <footer>
    Priors — <a href="https://github.com/santiagoCSM/priors">código fuente</a>.
    Cada proyecto vive en su propio repositorio; este sitio solo los indexa
    y agrega su estado.
  </footer>
</BaseLayout>

<script>
  const sectionLinks = document.querySelectorAll<HTMLAnchorElement>(".page-index a");

  function updateCurrentSection() {
    const current = location.hash || "#inicio";
    for (const link of sectionLinks) {
      if (link.hash === current) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    }
  }

  updateCurrentSection();
  window.addEventListener("hashchange", updateCurrentSection);
</script>
